 "englishNote": "Latin letters incl. accents (to U+024F), general punctuation, currency, arrows, symbols and emoji. Other scripts are rejected.",
 "linkPattern": "(https?:\\/\\/|www\\.|\\b[a-z0-9-]+\\.(?:com|net|org|au|io|co|me|ly|info|biz|xyz)\\b|@\\w{2,})",
 "leet": {
  "@": "a",
  "4": "a",
  "3": "e",
  "1": "i",
  "!": "i",
  "|": "i",
  "0": "o",
  "$": "s",
  "5": "s"
 },
